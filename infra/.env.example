# Copy this file to infra/.env (which git ignores) and fill in the three marked values.
# These are LOCAL development values. Never put production secrets in a file in the repo.

GAZI_ENVIRONMENT=development
GAZI_LOG_LEVEL=INFO

# The local Supabase database, reached from inside Docker. Password comes from infra/supabase/seed.sql.
GAZI_DATABASE_URL=postgresql://gazi_api:gazi-local-dev@host.docker.internal:54322/postgres

# Local Supabase Auth. Sign-in tokens are ES256, checked against the public keys at the JWKS URL.
GAZI_GOTRUE_URL=http://host.docker.internal:54321/auth/v1
GAZI_JWT_JWKS_URL=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
# The next three come from: npx supabase status --workdir infra -o env
# FILL IN: the value of JWT_SECRET (only for older HS256 tokens)
GAZI_JWT_SECRET=
# FILL IN: the value of SERVICE_ROLE_KEY
GAZI_GOTRUE_SERVICE_KEY=
# FILL IN: the value of ANON_KEY (used only by scripts/dev_token.py)
GAZI_DEV_ANON_KEY=

# FILL IN: a random master key. Generate one with:
#   docker run --rm python:3.12-slim python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
GAZI_KEK=
GAZI_KEK_VERSION=1

# Billing (Stripe sandbox for local development). Leave the key empty to run without billing: nothing is gated.
# Secret key: Stripe Dashboard > Developers > API keys (sk_test_... or a restricted rk_test_...).
GAZI_STRIPE_SECRET_KEY=
# The plan's price id (price_...).
GAZI_STRIPE_PRICE_ID=
# Printed by: stripe listen --forward-to localhost:8000/webhooks/stripe
GAZI_STRIPE_WEBHOOK_SECRET=
# Monthly AI token packs on top of the base plan, as price_id:tokens pairs (+2M $49, +5M $99, +12M $199).
GAZI_STRIPE_TOKEN_PACKS=
# AI tokens included per workspace and calendar month, before packs.
GAZI_INCLUDED_TOKENS=2000000
# Where Stripe sends people back after checkout and the billing portal.
GAZI_APP_URL=http://localhost:3000

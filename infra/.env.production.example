# Copy to infra/.env.production on the server (git ignores it). Non-secret settings only; secrets go in
# infra/secrets/<name> files (see docs/runbooks/production.md).
GAZI_DOMAIN=app.your-domain.com
GAZI_APP_URL=https://app.your-domain.com
GAZI_LOG_LEVEL=INFO

# Supabase (self-hosted), reached on its Docker network.
GAZI_GOTRUE_URL=http://supabase-auth:9999
GAZI_JWT_JWKS_URL=http://supabase-auth:9999/.well-known/jwks.json
SUPABASE_ANON_KEY=
SUPABASE_NETWORK=supabase_default

GAZI_KEK_VERSION=1
GAZI_STRIPE_PRICE_ID=
GAZI_STRIPE_TOKEN_PACKS=
GAZI_EMAIL_FROM=reports@your-domain.com

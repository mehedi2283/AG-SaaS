# Gazi behind Nginx. ${GAZI_DOMAIN} is filled in by the nginx image's envsubst (NGINX_ENVSUBST_TEMPLATE_*).
# Upload limit: 50m only on lead imports (large Apollo CSVs), 1m everywhere else (CLAUDE.md).

limit_req_zone $binary_remote_addr zone=webhooks:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=30r/m;  # sign-in, sign-up, password reset
limit_req_status 429;
server_tokens off;

server {
  listen 80;
  server_name ${GAZI_DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${GAZI_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${GAZI_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${GAZI_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
  # Everything is same-origin (API, Supabase Auth, fonts); Stripe is a full-page redirect.
  # shortcut: 'unsafe-inline' scripts for Next's inline bootstrap, move to per-request nonces if XSS risk grows.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

  client_max_body_size 1m;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  # The browser calls /api/* (frontend/src/lib/api.ts); in production Nginx sends it straight to the API.
  location /api/v1/lead-imports {
    client_max_body_size 50m;
    limit_req zone=api burst=10 nodelay;
    proxy_request_buffering off;  # stream large CSVs to the API, which writes them to disk as they arrive
    proxy_read_timeout 300s;
    proxy_pass http://api:8000/v1/lead-imports;
  }
  location /api/ {
    limit_req zone=api burst=60 nodelay;
    proxy_pass http://api:8000/;
  }

  # Provider webhooks (Instantly, HeyReach, Calendly, Stripe). No JWT; token or signature checked by the API.
  location /webhooks/ {
    limit_req zone=webhooks burst=100 nodelay;
    proxy_pass http://api:8000/webhooks/;
  }

  location = /healthz { proxy_pass http://api:8000/healthz; }

  # Supabase Auth for the browser (sign-in), served from the same domain.
  location /auth/v1/ {
    limit_req zone=auth burst=20 nodelay;
    proxy_pass http://supabase-kong:8000/auth/v1/;
  }

  location / {
    proxy_pass http://frontend:3000;
  }
}

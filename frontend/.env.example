# Copy to frontend/.env.local (git ignores it). infra/dev-setup.ps1 writes it for you.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The ANON_KEY from: npx supabase status --workdir infra -o env
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where the browser-facing webhook addresses point. Providers need a public address in production.
NEXT_PUBLIC_API_PUBLIC_URL=http://localhost:8000
# Where Next forwards /api/* (server side).
GAZI_API_URL=http://localhost:8000
